# ============================================================
# MEUX LAB - .gitignore
# ============================================================

# --- Dependencias ---
node_modules/
**/node_modules/
.pnpm-store/

# --- Variables de entorno y secretos ---
.env
.env.local
.env.development
.env.production
*.pem
*.key

# --- Builds y artefactos de compilación ---
dist/
build/
out/
.next/
*.tsbuildinfo

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Testing y cobertura ---
coverage/
.nyc_output/

# --- Editor / IDE ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# --- Sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini

# --- Base de datos local ---
*.sqlite
*.sqlite3
pgdata/

# --- Cache de herramientas ---
.eslintcache
.cache/
.turbo/

# --- Otros ---
*.local

# AI assistant files installed by tools (not project code)
.agents/
.claude/
.windsurf/
skills-lock.json
